<Page x:Class="ComePC.Pages.Registers"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComePC.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Registers">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition />
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Label Content="Регистрация"
               FontSize="48"/>

        <Grid Grid.Row="1"
              Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <ScrollViewer>
                <StackPanel Margin="0,10">

                    <TextBox x:Name="Name_TXB"
                             FontSize="24"
                             Width="355"
                             HorizontalAlignment="Left"
                             mah:TextBoxHelper.Watermark="Имя"/>

                    <TextBox x:Name="First_TXB"
                             Margin="0,10,0,0"
                             FontSize="24"
                             Width="355"
                             HorizontalAlignment="Left"
                             mah:TextBoxHelper.Watermark="Фамилия"/>

                    <TextBox x:Name="Login_TXB"
                             Margin="0,10,0,0"
                             FontSize="24"
                             Width="355"
                             HorizontalAlignment="Left"
                             mah:TextBoxHelper.Watermark="Логин"/>

                    <PasswordBox x:Name="Pas_PSB"
                                 Margin="0,10,0,0"
                                 FontSize="24"
                                 Width="355"
                                 HorizontalAlignment="Left"
                                 mah:TextBoxHelper.Watermark="Пароль"/>

                    <PasswordBox x:Name="Pas2_PSB"
                                 Margin="0,10,0,0"
                                 FontSize="24"
                                 Width="355"
                                 HorizontalAlignment="Left"
                                 mah:TextBoxHelper.Watermark="Пов. пароль"/>

                    <TextBox x:Name="Email_TXB"
                             Margin="0,10,0,0"
                             FontSize="24"
                             Width="355"
                             HorizontalAlignment="Left"
                             mah:TextBoxHelper.Watermark="Почта"/>
                    <CheckBox x:Name="EmailTrue_CHB"
                              Content="Приватная почта"
                              Margin="0,3,0,0"/>

                    <TextBox x:Name="Phone_TXB"
                             Margin="0,10,0,0"
                             FontSize="24"
                             Width="355"
                             HorizontalAlignment="Left"
                             mah:TextBoxHelper.Watermark="Телефон"/>
                    <CheckBox x:Name="PhoneTrue_CHB"
                              Content="Приватный Телефон"
                              Margin="0,3,0,0"/>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="1"
                        Margin="5,10"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left">
                
                <Image x:Name="Avatar_IMG"
                       Width="180"
                       Height="180"
                       Source="/Img/user-200.png"/>

                <Button x:Name="AvatarFolder_BT"
                        Margin="0,7,0,0"
                        Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
                        Content="Загрузить фото"
                        FontSize="20"
                        Padding="10,4" Click="AvatarFolder_BT_Click"/>
                
            </StackPanel>

        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,10">

            <Button x:Name="Register_BT"
                    Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
                    Content="Зарегестрироваться"
                    FontSize="20"
                    Padding="10,4" Click="Register_BT_Click"/>

            <Button x:Name="Login_BT"
                    Style="{StaticResource MahApps.Styles.Button.Square}"
                    Margin="7,0,0,0"
                    Content="Войти"
                    FontSize="20"
                    Padding="10,4" Click="Login_BT_Click"/>
        </StackPanel>

    </Grid>
</Page>
