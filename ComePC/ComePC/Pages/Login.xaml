<Page x:Class="ComePC.Pages.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComePC.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Login">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition />
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Label Content="Авторизация"
               FontSize="48"/>

        <StackPanel Grid.Row="1"
                    Margin="0,10">
            
            <TextBox x:Name="Login_TXB"
                     FontSize="24"
                     Width="370"
                     HorizontalAlignment="Left"
                     mah:TextBoxHelper.Watermark="Логин"/>

            <PasswordBox x:Name="Pas_PSB"
                         Margin="0,10"
                         FontSize="24"
                         Width="370"
                         HorizontalAlignment="Left"
                         mah:TextBoxHelper.Watermark="Пароль"/>

            <Label Content="*Неверный логин или пароль"
                   FontSize="22"
                   Foreground="#CCAC00"
                   x:Name="Error_TX"
                   Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,10">
            
            <Button x:Name="Login_BT"
                    Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
                    Content="Войти"
                    FontSize="20"
                    Padding="10,4" Click="Login_BT_Click"/>

            <Button x:Name="Register_BT"
                    Style="{StaticResource MahApps.Styles.Button.Square}"
                    Margin="7,0,0,0"
                    Content="Зарегестрироваться"
                    FontSize="20"
                    Padding="10,4" Click="Register_BT_Click"/>
        </StackPanel>
        
    </Grid>
</Page>
